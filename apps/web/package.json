{
  "name": "isaac-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "ISAAC Metadata Assistant \u2014 local UI prototype (Scientific Clarity design system). Static, synthetic, offline.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:e2e:install": "playwright install --with-deps chromium",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json --noEmit",
    "test:e2e:mutation": "playwright test --config=playwright.mutation.config.ts",
    "test:e2e:trusted": "playwright test --config=playwright.trusted.config.ts",
    "bench:runs": "playwright test --config=playwright.bench.config.ts --reporter=list"
  },
  "dependencies": {
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^15.0.7",
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "axe-core": "^4.12.1",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
