# Local development only. On Vercel, set these in the project's Environment Variables yourself.
# The password the scientist types at sign-in (at least 12 characters). Pick your own for the real site; this
# value is for localhost.
SITE_PASSWORD=local-test-only
# Where the local dev server keeps answers (a JSON file). On Vercel, answers go to Upstash Redis instead:
# add "Upstash for Redis" from the project's Storage tab and it sets KV_REST_API_URL and KV_REST_API_TOKEN.
QUESTION_SITE_DEV_STORE=.dev-store.json
