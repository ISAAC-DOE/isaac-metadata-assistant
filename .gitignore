# derived knowledge graph — rebuilt from the repo, never source of truth
graphify-out/

# user-supplied experiment artifacts may be sensitive (SLAC data governance):
# keep them out of git by default
examples/*
!examples/README.md

# python
.venv/
# ...AND `.venv` WITHOUT THE SLASH, because the pattern above does not match a
# SYMLINK of that name. On 2026-08-26 an agent working in a git worktree created
# `.venv` as a symlink to the main checkout's interpreter so its tests could run,
# `git add -A` swept it in, and it reached `main` through a merged PR. Checking
# main out then REPLACED the real virtualenv directory with a symlink pointing at
# itself — every `.venv/bin/python` invocation failed with "too many levels of
# symbolic links" until the venv was rebuilt from scratch.
.venv
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/

# node — dependencies and tool caches, at any depth. The frontend lives in
# apps/web, but a vitest/vite run from the REPO ROOT drops a cache at
# ./node_modules, which was previously unignored and stageable by `git add -A`.
node_modules/

# os
.DS_Store

