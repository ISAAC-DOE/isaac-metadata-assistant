{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "isaac_record.schema.json",
  "title": "ISAAC Record (provisional)",
  "description": "Provisional ISAAC record schema authored from the SSRL Excel metadata template and web-form fields. Marked provisional until the official ISAAC schema is obtained or this draft receives mentor/team sign-off. Every scientific field is an envelope {value, unit?, status, evidence[]}; a non-null finalized field without evidence is invalid by design.",
  "x-provisional": true,
  "x-schema-version": "0.1.0-provisional",
  "type": "object",
  "properties": {
    "record_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]+$",
      "description": "Stable identifier, e.g. isaac-2026-cuo-xas-0001"
    },
    "schema_version": {
      "type": "string",
      "description": "Version of this schema the record was written against"
    },
    "sample": {
      "type": "object",
      "properties": {
        "name": { "$ref": "#/$defs/field" },
        "sample_id": { "$ref": "#/$defs/field" },
        "formula": { "$ref": "#/$defs/field" },
        "physical_form": { "$ref": "#/$defs/field" },
        "preparation": { "$ref": "#/$defs/field" }
      },
      "required": ["name", "formula", "physical_form"],
      "additionalProperties": false
    },
    "technique": {
      "type": "object",
      "properties": {
        "name": { "$ref": "#/$defs/field" },
        "xas": {
          "type": "object",
          "properties": {
            "absorbing_element": { "$ref": "#/$defs/field" },
            "edge": { "$ref": "#/$defs/field" },
            "detection_mode": { "$ref": "#/$defs/field" }
          },
          "additionalProperties": false
        }
      },
      "required": ["name"],
      "additionalProperties": false
    },
    "instrument": {
      "type": "object",
      "properties": {
        "facility": { "$ref": "#/$defs/field" },
        "beamline": { "$ref": "#/$defs/field" },
        "session": { "$ref": "#/$defs/field" },
        "detectors": { "$ref": "#/$defs/field" }
      },
      "required": ["facility", "beamline"],
      "additionalProperties": false
    },
    "conditions": {
      "type": "object",
      "properties": {
        "environment": { "$ref": "#/$defs/field" },
        "cell_type": { "$ref": "#/$defs/field" },
        "temperature": { "$ref": "#/$defs/field" },
        "pressure": { "$ref": "#/$defs/field" },
        "atmosphere": { "$ref": "#/$defs/field" },
        "gas_flow": { "$ref": "#/$defs/field" },
        "electrolyte": { "$ref": "#/$defs/field" },
        "ph": { "$ref": "#/$defs/field" },
        "potential": { "$ref": "#/$defs/field" }
      },
      "required": ["environment"],
      "additionalProperties": false
    },
    "raw_data": {
      "type": "object",
      "description": "Raw data is linked, never copied into the record.",
      "properties": {
        "uris": { "$ref": "#/$defs/field" },
        "filename_pattern": { "$ref": "#/$defs/field" }
      },
      "required": ["uris"],
      "additionalProperties": false
    },
    "descriptors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "data": { "$ref": "#/$defs/field" }
        },
        "required": ["name", "data"],
        "additionalProperties": false
      }
    },
    "provenance": {
      "type": "object",
      "description": "Record-level metadata (who/when/from what), not scientific claims — no envelope needed.",
      "properties": {
        "created_by": { "type": "string" },
        "created_at": { "type": "string" },
        "source_files": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["created_by", "created_at"],
      "additionalProperties": false
    },
    "notes": { "type": "string" }
  },
  "required": [
    "record_id",
    "schema_version",
    "sample",
    "technique",
    "instrument",
    "conditions",
    "raw_data",
    "provenance"
  ],
  "additionalProperties": false,
  "$defs": {
    "field": {
      "type": "object",
      "description": "Field envelope: no finalized value without evidence.",
      "properties": {
        "value": {},
        "unit": { "type": ["string", "null"] },
        "status": {
          "enum": ["verified", "inferred", "needs_confirmation", "missing", "rejected"]
        },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence" }
        }
      },
      "required": ["value", "status", "evidence"],
      "allOf": [
        {
          "if": { "properties": { "status": { "enum": ["verified", "inferred"] } } },
          "then": { "properties": { "evidence": { "minItems": 1 } } }
        },
        {
          "if": { "properties": { "status": { "const": "missing" } } },
          "then": { "properties": { "value": { "type": "null" } } }
        }
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "source_type": {
          "enum": [
            "document",
            "spreadsheet",
            "screenshot",
            "web_form",
            "file_listing",
            "user_confirmation",
            "derivation"
          ]
        },
        "source_file": { "type": ["string", "null"] },
        "locator": {
          "type": ["string", "null"],
          "description": "Where in the source: sheet+cell, page, screenshot region, form field"
        },
        "quote": { "type": ["string", "null"] },
        "question": { "type": "string" },
        "answer": { "type": "string" },
        "rule": {
          "type": "string",
          "description": "For derivation evidence: the stated rule the value was derived by"
        },
        "timestamp": { "type": "string" }
      },
      "required": ["source_type"],
      "allOf": [
        {
          "if": { "properties": { "source_type": { "const": "user_confirmation" } } },
          "then": { "required": ["question", "answer", "timestamp"] }
        },
        {
          "if": { "properties": { "source_type": { "const": "derivation" } } },
          "then": { "required": ["rule"] }
        },
        {
          "if": {
            "properties": {
              "source_type": {
                "enum": ["document", "spreadsheet", "screenshot", "web_form", "file_listing"]
              }
            }
          },
          "then": { "required": ["source_file", "locator"] }
        }
      ],
      "additionalProperties": false
    }
  },
  "x-field-rules": {
    "description": "Machine-readable rules the deterministic validator enforces beyond JSON Schema structure. Kept inside the schema file so the schema remains the single source of truth.",
    "required": [
      "sample.name",
      "sample.formula",
      "sample.physical_form",
      "technique.name",
      "instrument.facility",
      "instrument.beamline",
      "conditions.environment",
      "raw_data.uris"
    ],
    "technique_requirements": {
      "XAS": [
        "technique.xas.absorbing_element",
        "technique.xas.edge",
        "technique.xas.detection_mode"
      ],
      "XANES": [
        "technique.xas.absorbing_element",
        "technique.xas.edge",
        "technique.xas.detection_mode"
      ],
      "EXAFS": [
        "technique.xas.absorbing_element",
        "technique.xas.edge",
        "technique.xas.detection_mode"
      ]
    },
    "vocabulary": {
      "technique.name": "technique",
      "sample.physical_form": "physical_form",
      "conditions.environment": "environment",
      "technique.xas.detection_mode": "detection_mode",
      "technique.xas.edge": "edge"
    },
    "units": {
      "conditions.temperature": "kelvin",
      "conditions.pressure": "pascal",
      "conditions.potential": "volt",
      "conditions.gas_flow": "milliliter / minute"
    }
  }
}
